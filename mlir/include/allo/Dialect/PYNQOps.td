/*
 * PYNQ Hardware Instruction Dialect
 * 
 * This dialect defines low-level hardware instruction operations that directly
 * correspond to the PYNQ accelerator's instruction encoding format.
 * These ops model the 32-bit instruction format from instr.h and provide
 * a thin MLIR abstraction over hardware capabilities.
 * 
 * Reference: PYNQ_api/include/instr.h
 *   - gen_matmul_instr: 32-bit packed instruction for matrix multiplication
 *   - gen_data_instr: DMA data transfer instruction
 */

include "mlir/IR/OpBase.td"
include "mlir/Interfaces/SideEffectInterfaces.td"
include "mlir/IR/SymbolInterfaces.td"

// Define the PYNQ Dialect
def PYNQ_Dialect : Dialect {
  let name = "pynq";
  let summary = "PYNQ hardware accelerator instruction dialect";
  let description = [{
    This dialect provides low-level operations that map directly to PYNQ
    hardware instructions. It models the tiled matrix accelerator with:
    - 8 on-chip buffers (3-bit buffer IDs)
    - 32-row BRAM organization (2 groups)
    - int8 input data, int32 accumulator
    - Explicit DMA transfers via shared memory
    
    These operations are NOT intended to be written by users directly, but
    rather generated by lowering passes from higher-level operations.
  }];
  let cppNamespace = "::mlir::allo::pynq";
}

// Base class for PYNQ operations
class PYNQ_Op<string mnemonic, list<Trait> traits = []> :
    Op<PYNQ_Dialect, mnemonic, traits>;

//===----------------------------------------------------------------------===//
// PYNQ MatMul Instruction Op
//===----------------------------------------------------------------------===//

def PYNQ_MatMulInstrOp : PYNQ_Op<"matmul_instr", []> {
  let summary = "Hardware matrix multiplication instruction";
  let description = [{
    Encodes a single PYNQ matmul instruction that executes on the accelerator.
    Maps directly to gen_matmul_instr() in instr.h.
    
    Instruction format (32 bits):
      bits[0:2]   - input_buffer_id (3 bits)
      bits[3:5]   - weight_buffer_id (3 bits)
      bits[6:8]   - output_buffer_id (3 bits)
      bits[9:11]  - input_tile_count - 1 (3 bits, value 0-7 represents 1-8 tiles)
      bits[12:14] - weight_tile_count - 1 (3 bits)
      bits[15:22] - bram_rows - 1 (8 bits, value 0-255 represents 1-256 rows)
      bits[23:30] - bias_tile_index (8 bits)
      bit[31]     - transpose flag (1 = transpose weight matrix)
    
    Hardware constraints:
    - Buffer IDs must be in range [0, 7]
    - Tile counts must be in range [1, 8] (encoded as count-1)
    - BRAM rows typically 32 for standard tiling
    - Each tile is 32 elements for int8 data
    
    Example:
      pynq.matmul_instr 
        input_buf = 0, weight_buf = 1, output_buf = 2,
        input_tiles = 4, weight_tiles = 4, bram_rows = 32,
        bias_idx = 0, transpose = false
  }];
  
  let arguments = (ins
    I3:$input_buffer_id,
    I3:$weight_buffer_id,
    I3:$output_buffer_id,
    I3:$input_tile_count,    // Actual count (1-8), will be encoded as count-1
    I3:$weight_tile_count,   // Actual count (1-8), will be encoded as count-1
    I8:$bram_rows,           // Actual count (1-256), will be encoded as rows-1
    I8:$bias_tile_index,     // Index into bias buffer, 0 if no bias
    I1:$transpose            // 0 = no transpose, 1 = transpose weight
  );
  
  let results = (outs);
  
  let assemblyFormat = [{
    `input_buf` `=` $input_buffer_id `,`
    `weight_buf` `=` $weight_buffer_id `,`
    `output_buf` `=` $output_buffer_id `,`
    `input_tiles` `=` $input_tile_count `,`
    `weight_tiles` `=` $weight_tile_count `,`
    `bram_rows` `=` $bram_rows `,`
    `bias_idx` `=` $bias_tile_index `,`
    `transpose` `=` $transpose
    attr-dict
  }];
  
  let hasVerifier = 1;
}

//===----------------------------------------------------------------------===//
// PYNQ Data Transfer Op
//===----------------------------------------------------------------------===//

def PYNQ_DataTransferOp : PYNQ_Op<"data_transfer", []> {
  let summary = "DMA data transfer between host and device";
  let description = [{
    Transfers matrix data between host memory and on-chip buffer via DMA.
    Maps to gen_data_instr() + transfer_matrix_int8() / transfer_matrix_back()
    pattern in main.cpp.
    
    Instruction format (32 bits):
      bits[0:11]  - total_num (12 bits, total number of elements)
      bits[12:14] - tile_count - 1 (3 bits)
      bits[15:17] - buffer_id (3 bits)
      bits[18:31] - reserved (14 bits)
    
    Direction:
      0 = host -> device (load to on-chip buffer)
      1 = device -> host (store from on-chip buffer)
    
    Hardware constraints:
    - Buffer ID must be in range [0, 7]
    - Tile count in range [1, 8]
    - Total elements must fit in shared memory
    - Data layout must match split_by_rows/split_by_cols format
    
    The memref operand contains the host-side data buffer. For load operations,
    data is read from memref and transferred to device. For store operations,
    data is transferred from device and written to memref.
    
    Example:
      // Load input matrix to buffer 0
      pynq.data_transfer %input_memref, buffer_id = 0, tiles = 4, 
                        total_num = 128, direction = 0
      
      // Store result from buffer 2 back to host
      pynq.data_transfer %output_memref, buffer_id = 2, tiles = 4,
                        total_num = 128, direction = 1
  }];
  
  let arguments = (ins
    AnyMemRef:$data,          // Host memory buffer (int8 memref)
    I3:$buffer_id,            // On-chip buffer ID (0-7)
    I3:$tile_count,           // Number of tiles (1-8), encoded as count-1
    I12:$total_num,           // Total number of elements to transfer
    I1:$direction             // 0 = host->device, 1 = device->host
  );
  
  let results = (outs);
  
  let assemblyFormat = [{
    $data `,`
    `buffer_id` `=` $buffer_id `,`
    `tiles` `=` $tile_count `,`
    `total_num` `=` $total_num `,`
    `direction` `=` $direction
    attr-dict `:` type($data)
  }];
  
  let hasVerifier = 1;
}

//===----------------------------------------------------------------------===//
// PYNQ Buffer Allocation Op (pseudo-op for buffer management)
//===----------------------------------------------------------------------===//

def PYNQ_BufferAllocOp : PYNQ_Op<"buffer_alloc", []> {
  let summary = "Allocate on-chip buffer (pseudo-op for analysis)";
  let description = [{
    Represents allocation of one of the 8 on-chip buffers.
    This is a pseudo-operation used during lowering to track buffer
    assignments and lifetime. It does NOT generate actual hardware
    instructions but helps the compiler manage buffer IDs.
    
    During code generation, this op is used to:
    1. Assign unique buffer IDs to different data tensors
    2. Track which buffers are live at each point
    3. Detect buffer conflicts and insert spills if needed
    
    The op will be erased during final emission and replaced with
    explicit buffer ID constants in matmul_instr and data_transfer ops.
    
    Example:
      %buf0 = pynq.buffer_alloc 0 : !pynq.buffer<i8>
      // ... use %buf0 in transfers and matmul instructions ...
  }];
  
  let arguments = (ins
    I3:$buffer_id  // Requested buffer ID (0-7)
  );
  
  let results = (outs
    // Symbolic reference to the allocated buffer
    // Will be lowered to actual buffer ID constant
    AnyType:$buffer_handle
  );
  
  let assemblyFormat = [{
    $buffer_id attr-dict `:` type($buffer_handle)
  }];
}

//===----------------------------------------------------------------------===//
// PYNQ Synchronization Op
//===----------------------------------------------------------------------===//

def PYNQ_SyncOp : PYNQ_Op<"sync", []> {
  let summary = "Synchronization barrier for accelerator completion";
  let description = [{
    Inserts a synchronization point that waits for all pending hardware
    operations to complete before proceeding. Maps to polling the
    accelerator status register or using interrupt-based synchronization.
    
    This is necessary before:
    1. Reading back results from device to host
    2. Issuing dependent operations on the same buffers
    3. Program termination
    
    Example:
      pynq.matmul_instr ...
      pynq.sync  // Wait for matmul to complete
      pynq.data_transfer ..., direction = 1  // Now safe to read result
  }];
  
  let arguments = (ins);
  let results = (outs);
  
  let assemblyFormat = [{ attr-dict }];
}

