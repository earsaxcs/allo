#ifndef PYNQ_DIALECT
#define PYNQ_DIALECT

include "mlir/IR/AttrTypeBase.td"
include "mlir/IR/OpBase.td"

//===----------------------------------------------------------------------===//
// PYNQ dialect definition
//===----------------------------------------------------------------------===//

def PYNQ_Dialect : Dialect {
  let name = "pynq";
  let summary = "PYNQ hardware accelerator instruction dialect";
  let description = [{
    This dialect provides low-level operations that map directly to PYNQ
    hardware instructions. It models the tiled matrix accelerator with:
    - Configurable on-chip buffers (default: 8 buffers with 3-bit buffer IDs)
    - 32-row BRAM organization (2 groups)
    - int8 input data, int32 accumulator
    - Explicit DMA transfers via shared memory
    
    These operations are NOT intended to be written by users directly, but
    rather generated by lowering passes from higher-level operations.
    
    Hardware constraints are configurable through dialect attributes:
    - Number of buffers (default: 8)
    - Buffer capacity in bytes (default: 1024)
    - Tile size (default: 32 elements)
  }];
  let cppNamespace = "::mlir::allo::pynq";
  let useDefaultTypePrinterParser = 1;
  
  let extraClassDeclaration = [{
    //===------------------------------------------------------------------===//
    // Hardware Configuration (see allo/Dialect/PYNQConfig.h for details)
    //===------------------------------------------------------------------===//
    // Note: Use pynq::BufferConfig, TileConfig, etc. from PYNQConfig.h
    // These legacy constants maintained for backward compatibility only.
    
    /// @deprecated Use pynq::BufferConfig::kNumBuffers
    static constexpr unsigned kDefaultNumBuffers = 8;
    
    /// @deprecated Use pynq::BufferConfig::kMaxBufferId
    static constexpr unsigned kDefaultMaxBufferId = 7;
    
    /// @deprecated Use pynq::BufferConfig::kDefaultCapacityBytes
    static constexpr int64_t kDefaultBufferCapacityBytes = 65536;
    
    /// @deprecated Use pynq::TileConfig::kElementsPerTile
    static constexpr unsigned kDefaultTileSize = 32;
    
    /// @deprecated Use pynq::InstrConfig::kMaxTileCount
    static constexpr unsigned kMaxTileCount = 8;
    
    /// @deprecated Use pynq::InstrConfig::kMaxReduceK
    static constexpr unsigned kMaxBramRows = 256;
  }];
}

//===----------------------------------------------------------------------===//
// Base PYNQ operation definition
//===----------------------------------------------------------------------===//

class PYNQ_Op<string mnemonic, list<Trait> traits = []> :
    Op<PYNQ_Dialect, mnemonic, traits>;

//===----------------------------------------------------------------------===//
// Base PYNQ type definition
//===----------------------------------------------------------------------===//

class PYNQ_Type<string mnemonic, list<Trait> traits = []> :
    TypeDef<PYNQ_Dialect, mnemonic, traits>;

#endif // PYNQ_DIALECT
